        public function get_deposit($id)\par
        \{\par
        $this->db->select('student_fees_master.id, student_fees_deposite.amount_detail');\par
        $this->db->from('student_fees_master');\par
        $this->db->join('student_fees_deposite', 'student_fees_deposite.student_fees_master_id = student_fees_master.id');\par
        $this->db->where('student_fees_master.student_session_id', $id);\par
        $query = $this->db->get();\par
        $results = $query->result();\par
        $total_amount = 0;\par
\par
        foreach ($results as $row) \{\par
        $details = json_decode($row->amount_detail, true);\par
        foreach ($details as $item) \{\par
        $total_amount += (float) $item['amount'];\par
        \}\par
        \}\par
        return $total_amount; \par
        \}\par
