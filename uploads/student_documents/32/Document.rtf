function convertToDate(dateStr) \{\par
        // Assumes format: dd-MMM-yyyy (e.g. 21-Jun-2025)\par
        const parts = dateStr.trim().split('-');\par
        if (parts.length !== 3) return null;\par
\par
        const day = parseInt(parts[0], 10);\par
        const monthStr = parts[1].toLowerCase();\par
        const year = parseInt(parts[2], 10);\par
\par
        const monthNames = \{\par
            jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5,\par
            jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11\par
        \};\par
\par
        const month = monthNames[monthStr];\par
        if (month === undefined || isNaN(day) || isNaN(year)) return null;\par
\par
        return new Date(year, month, day);\par
        \}\par
