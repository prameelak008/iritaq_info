function validateRows() \{\par
    var isValid = true;\par
\par
    $('#item_table input, #item_table select').removeClass('is-invalid');\par
\par
    $('#item_table tbody tr').each(function () \{\par
        var row = $(this);\par
        var subject = row.find('select[name^="subject_"]').val();\par
        var date_from = row.find('input[name^="date_from_"]').val();\par
        var time_from = row.find('input[name^="time_from"]').val();\par
        var duration = row.find('.duration').val();\par
        var credit_hours = row.find('.credit_hours').val();\par
        var room_no = row.find('.room_no').val();\par
        var max_marks = row.find('.max_marks').val();\par
        var min_marks = row.find('.min_marks').val();\par
\par
        if (!subject) \{\par
            row.find('select[name^="subject_"]').addClass('is-invalid');\par
            isValid = false;\par
        \}\par
        if (!date_from) \{\par
            row.find('input[name^="date_from_"]').addClass('is-invalid');\par
            isValid = false;\par
        \}\par
        if (!time_from) \{\par
            row.find('input[name^="time_from"]').addClass('is-invalid');\par
            isValid = false;\par
        \}\par
        if (!duration || duration <= 0) \{\par
            row.find('.duration').addClass('is-invalid');\par
            isValid = false;\par
        \}\par
        if (!credit_hours || credit_hours <= 0) \{\par
            row.find('.credit_hours').addClass('is-invalid');\par
            isValid = false;\par
        \}\par
        if (!room_no) \{\par
            row.find('.room_no').addClass('is-invalid');\par
            isValid = false;\par
        \}\par
        if (!max_marks || max_marks <= 0) \{\par
            row.find('.max_marks').addClass('is-invalid');\par
            isValid = false;\par
        \}\par
        if (!min_marks || min_marks < 0) \{\par
            row.find('.min_marks').addClass('is-invalid');\par
            isValid = false;\par
        \}\par
    \});\par
\par
    return isValid;\par
\}\par
